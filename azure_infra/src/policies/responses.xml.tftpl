<policies>
  <inbound>
    <base />
    <validate-azure-ad-token tenant-id="${tenant_id}" header-name="Authorization" failed-validation-httpcode="401" failed-validation-error-message="Missing or invalid gateway access token." output-token-variable-name="gateway-jwt">
      <client-application-ids>
        <application-id>${codex_client_id}</application-id>
      </client-application-ids>
      <audiences>
        <audience>${gateway_client_id}</audience>
      </audiences>
      <required-claims>
        <claim name="scp" match="all" separator=" ">
          <value>Codex.Access</value>
        </claim>
        <claim name="roles" match="any">
          <value>Codex.User</value>
        </claim>
      </required-claims>
    </validate-azure-ad-token>
    <rate-limit-by-key calls="${requests_per_minute}" renewal-period="60" counter-key='@(((Jwt)context.Variables["gateway-jwt"]).Claims.GetValueOrDefault("tid", "") + ":" + ((Jwt)context.Variables["gateway-jwt"]).Claims.GetValueOrDefault("oid", ""))' />
    <set-variable id="parse-model" name="requested-model" value='@{
      var body = context.Request.Body.As&lt;JObject&gt;(preserveContent: true);
      var model = body != null ? body["model"] : null;
      return model != null &amp;&amp; model.Type == JTokenType.String ? (string)model : "";
    }' />
    <choose>
      <when condition='@(!JArray.Parse(${allowed_models}).Values&lt;string&gt;().Contains((string)context.Variables["requested-model"]))'>
        <return-response>
          <set-status code="400" reason="Bad Request" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-body>{"error":{"message":"A valid JSON object with an approved model deployment name is required.","type":"invalid_request_error"}}</set-body>
        </return-response>
      </when>
    </choose>
    <set-header name="api-key" exists-action="delete" />
    <authentication-managed-identity resource="https://cognitiveservices.azure.com" ignore-error="false" />
  </inbound>
  <backend>
    <forward-request timeout="240" buffer-response="false" fail-on-error-status-code="false" />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
    <choose>
      <when condition='@(context.LastError.PolicyId == "parse-model")'>
        <return-response>
          <set-status code="400" reason="Bad Request" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-body>{"error":{"message":"The request body must be a valid JSON object.","type":"invalid_request_error"}}</set-body>
        </return-response>
      </when>
    </choose>
  </on-error>
</policies>
